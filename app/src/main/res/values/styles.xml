<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/primary_color</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent_color</item>
        <item name="android:fontFamily">@font/cairo_regular</item>
    </style>

    <!-- Splash Screen Theme -->
    <style name="SplashTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_gradient_background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>

    <!-- Text Styles -->
    <style name="TitleTextStyle">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/cairo_bold</item>
    </style>

    <style name="SubtitleTextStyle">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">@font/cairo_regular</item>
    </style>

    <style name="BodyTextStyle">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/cairo_regular</item>
    </style>

    <!-- Button Styles -->
    <style name="PrimaryButtonStyle">
        <item name="android:background">@drawable/primary_button_background</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/cairo_bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:elevation">4dp</item>
    </style>
    <style name="BottomNavigationText.Inactive">
        <item name="android:textColor">#888888</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="BottomNavigationText">
        <item name="android:textColor">@color/white_80</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="BottomNavigationText.Active" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/white_20</item>
    </style>
    <style name="CardViewStyle">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardUseCompatPadding">true</item>
        <item name="cardPreventCornerOverlap">false</item>
    </style>

    <!-- Button styles -->
    <style name="PrimaryButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:fontFamily">@font/cairo_bold</item>
    </style>

    <!-- Text styles -->
    <style name="HeaderText">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#333333</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/cairo_bold</item>
    </style>

    <style name="TitleText">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#333333</item>
        <item name="android:fontFamily">@font/cairo_bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="SubtitleText">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#666666</item>
        <item name="android:fontFamily">@font/cairo_regular</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="TotalText">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#4A90E2</item>
        <item name="android:fontFamily">@font/cairo_bold</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="EmptyText">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">#888888</item>
        <item name="android:fontFamily">@font/cairo_regular</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">16dp</item>
    </style>

    <!-- Icon styles -->
    <style name="IconButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/menu_button_bg</item>
        <item name="android:scaleType">centerInside</item>
    </style>

    <!-- Dialog styles -->
    <style name="DialogStyle" parent="Theme.AppCompat.Light.Dialog">
        <item name="colorPrimary">#4A90E2</item>
        <item name="colorAccent">#4A90E2</item>
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:textColorPrimary">#333333</item>
        <item name="android:fontFamily">@font/cairo_regular</item>
    </style>

</resources>