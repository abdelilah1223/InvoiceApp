<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- لون الخلفية -->
    <solid android:color="#FFFFFF"/>  <!-- أبيض -->

    <!-- حدود (الحد الخارجي) -->
    <stroke
        android:width="2dp"
        android:color="#FF6200EE"/> <!-- لون البنفسجي أو أي لون تريده -->

    <!-- الزوايا المستديرة -->
    <corners android:radius="16dp"/>

    <!-- تظليل (اختياري) -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp" />
</shape>
